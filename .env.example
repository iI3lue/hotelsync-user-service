# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3003

# Base de datos propia del servicio (Neon en produccion)
DATABASE_URL=postgresql://usuario:password@host:5432/user_db?sslmode=require

# HS256 compartido por todos los servicios (minimo 32 caracteres)
AUTH_JWT_SECRET=

# Auth0: login federado con Google (el front envia el id_token)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Recuperacion de contrasena
PASSWORD_RESET_BASE_URL=http://localhost:3000/cuenta/restablecer
# log = no hay envio real (desarrollo); smtp = envio real
MAILER_PROVIDER=log
# Solo desarrollo/demo: expone el codigo y el enlace de reset. Dejar vacio en produccion.
PASSWORD_RESET_DEMO_CODE=

# booking-service: verifica reservas activas antes de borrar una cuenta
BOOKING_SERVICE_URL=http://localhost:3004/v1
BOOKING_SERVICE_KEY=

# Clave interna que valida loyalty-service al consultar usuarios (x-loyalty-key)
LOYALTY_SERVICE_KEY=

# Solo para el seed: crea el primer SUPER_ADMIN si ambos valores existen
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
